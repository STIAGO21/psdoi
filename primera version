                questionCard.appendChild(qTitle);

                if (q.visualSvg) {
                    const svgDiv = document.createElement('div');
                    svgDiv.className = "py-2";
                    svgDiv.innerHTML = q.visualSvg;
                    questionCard.appendChild(svgDiv);
                }

                const optionsList = document.createElement('div');
                optionsList.className = "space-y-2.5 pl-0 sm:pl-10";

                q.options.forEach(opt => {
                    const isSelected = userAnswers[q.id] === opt.id;
                    const optLabel = document.createElement('label');
                    optLabel.className = `flex items-center gap-3 p-3.5 rounded-xl border cursor-pointer transition ${isSelected ? 'border-uniminuto-500 bg-uniminuto-50 font-semibold' : 'border-slate-200 hover:bg-slate-50 text-slate-700'}`;
                    
                    const inputRadio = document.createElement('input');
                    inputRadio.type = 'radio';
                    inputRadio.name = `question-${q.id}`;
                    inputRadio.value = opt.id;
                    inputRadio.checked = isSelected;
                    inputRadio.className = 'w-4 h-4 text-uniminuto-600';
                    inputRadio.onchange = () => {
                        userAnswers[q.id] = opt.id;
                        renderModule();
                    };

                    const optSpan = document.createElement('span');
                    optSpan.className = 'text-sm';
                    optSpan.textContent = `${opt.id.toUpperCase()}. ${opt.text}`;

                    optLabel.appendChild(inputRadio);
                    optLabel.appendChild(optSpan);
                    optionsList.appendChild(optLabel);
                });

                questionCard.appendChild(optionsList);
                container.appendChild(questionCard);
            });

            document.getElementById('btn-prev').disabled = (currentModuleIndex === 0);
            if (currentModuleIndex === modulesData.length - 1) {
                document.getElementById('btn-next').classList.add('hidden');
                document.getElementById('btn-to-register').classList.remove('hidden');
            } else {
                document.getElementById('btn-next').classList.remove('hidden');
                document.getElementById('btn-to-register').classList.add('hidden');
            }
        }

