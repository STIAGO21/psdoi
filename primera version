<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PSDOI - Screening Diagnóstico y Orientación Inclusiva | UNIMINUTO</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        uniminuto: {
                            50: '#eef6fc',
                            100: '#d9ecf9',
                            500: '#004c98',
                            600: '#003d7a',
                            700: '#002e5c',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Alto contraste extremo WCAG 2.1 AA */
        body.high-contrast {
            background-color: #000000 !important;
            color: #ffff00 !important;
        }
        body.high-contrast * {
            background-color: #000000 !important;
            color: #ffff00 !important;
            border-color: #ffff00 !important;
        }
        body.high-contrast button, body.high-contrast input, body.high-contrast select {
            background-color: #000000 !important;
            color: #ffff00 !important;
            border: 2px solid #ffff00 !important;
        }
        /* Modo Sepia / Descanso Visual */
        body.sepia-mode {
            background-color: #FBF0D9 !important;
            color: #433422 !important;
        }
        body.sepia-mode .bg-white, body.sepia-mode .bg-slate-50, body.sepia-mode .bg-uniminuto-50 {
            background-color: #F4E4C1 !important;
            color: #433422 !important;
            border-color: #D8C29D !important;
        }
        /* Focus styles for keyboard navigation */
        a:focus, button:focus, input:focus, select:focus, textarea:focus {
            outline: 4px solid #004c98 !important;
            outline-offset: 2px !important;
        }
        body.high-contrast *:focus {
            outline: 4px solid #ffff00 !important;
            outline-offset: 2px !important;
        }
        @media print {
            header, footer, button, #professional-modal, #student-report-actions, #modal-student-report, .no-print, #delete-modal, #analytics-modal {
                display: none !important;
            }
            body {
                background: white !important;
                color: black !important;
            }
            #view-start, #view-quiz, #view-results, #view-professional-dashboard {
                display: block !important;
                box-shadow: none !important;
                border: none !important;
            }
            body.printing-clean-test #modal-student-report {
                display: none !important;
            }
            body.printing-piar #main-content {
                display: none !important;
            }
            body.printing-piar #modal-student-report {
                display: block !important;
                position: static !important;
                background: transparent !important;
                box-shadow: none !important;
                border: none !important;
                width: 100% !important;
                max-width: 100% !important;
            }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col transition-colors duration-300" id="main-body">

    <!-- BARRA DE ACCESIBILIDAD Y NAVEGACIÓN SUPERIOR -->
    <header class="bg-uniminuto-600 text-white shadow-md sticky top-0 z-50 no-print" role="banner">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchView('start')" role="button" tabindex="0" aria-label="Ir al inicio del cuestionario PSDOI">
                <div class="bg-white text-uniminuto-600 font-extrabold px-3 py-1.5 rounded-lg text-lg tracking-wider shadow">
                    UNIMINUTO
                </div>
                <div>
                    <h1 class="text-base sm:text-lg font-bold leading-tight" id="main-title">PSDOI - Screening Diagnóstico y Orientación Inclusiva</h1>
                    <p class="text-xs text-slate-200">Área Accesible e Incluyente</p>
                </div>
            </div>

            <div class="flex items-center flex-wrap gap-2.5" role="region" aria-label="Controles institucionales y accesibilidad">
                <button onclick="printCleanTestPDF()" 
                    class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-3.5 py-2 rounded-xl shadow transition flex items-center gap-1.5 focus:ring-4 focus:ring-emerald-300"
                    aria-label="Imprimir o descargar la prueba completa en PDF">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    <span>Imprimir Prueba (PDF)</span>
                </button>

                <button onclick="openProfessionalPortalModal()" 
                    class="bg-amber-500 hover:bg-amber-600 text-slate-900 text-xs font-bold px-3.5 py-2 rounded-xl shadow transition flex items-center gap-1.5 focus:ring-4 focus:ring-amber-300"
                    aria-label="Acceso exclusivo para docentes y profesionales al panel de reportes">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    <span>Reportes Profesionales (PIN)</span>
                </button>

                <div class="relative">
                    <button onclick="toggleAccessibilityMenu()" id="accessibility-menu-btn"
                        class="bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold px-4 py-2 rounded-xl shadow-md transition flex items-center gap-2 focus:ring-4 focus:ring-purple-300"
                        aria-expanded="false" aria-haspopup="true">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path></svg>
                        <span>Accesibilidad</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>

                    <div id="accessibility-dropdown" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-2xl shadow-2xl border border-slate-200 p-3 text-slate-800 z-50 space-y-3">
                        <div class="text-xs font-bold text-slate-400 uppercase tracking-wider px-1">Opciones Visuales</div>
                        <button onclick="toggleContrast();" class="w-full text-left bg-slate-900 hover:bg-black text-yellow-400 text-xs font-semibold px-3 py-2.5 rounded-xl transition flex items-center gap-2">
                            <span>⚡ Alto Contraste (Negro/Amarillo)</span>
                        </button>
                        <button onclick="toggleSepia();" class="w-full text-left bg-amber-100 hover:bg-amber-200 text-amber-900 text-xs font-semibold px-3 py-2.5 rounded-xl transition flex items-center gap-2">
                            <span>☕ Modo Sepia / Descanso Visual</span>
                        </button>
                        <div class="pt-1 border-t border-slate-100 px-1">
                            <span class="block text-xs font-semibold text-slate-600 mb-1.5">Tamaño de Tipografía (<span id="font-size-indicator">100%</span>)</span>
                            <div class="flex items-center justify-between gap-2">
                                <button onclick="adjustFontSize(-1)" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold py-1.5 rounded-lg text-xs transition text-center">A-</button>
                                <button onclick="adjustFontSize(1)" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold py-1.5 rounded-lg text-xs transition text-center">A+</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- MODAL DE ACCESO PROFESIONAL CON PIN -->
    <div id="professional-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-md w-full p-6 space-y-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="bg-amber-100 text-amber-700 p-2.5 rounded-xl">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    </div>
                    <div>
                        <h3 class="font-extrabold text-slate-900 text-lg">Acceso Docente y Profesional</h3>
                        <p class="text-xs text-slate-500">Área Accesible e Incluyente UNIMINUTO</p>
                    </div>
                </div>
                <button onclick="closeProfessionalPortalModal()" class="text-slate-400 hover:text-slate-600 font-bold text-xl p-1">&times;</button>
            </div>
            
            <p class="text-sm text-slate-600">
                Ingrese el PIN institucional de seguridad para acceder al panel general con los resultados, datos socioeconómicos, tiempos y análisis PIAR fundamentado en APA (Decreto 1421, ONU 2006, Piaget, Palacios 2008).
            </p>

            <form onsubmit="verifyProfessionalPin(event)" class="space-y-4">
                <div>
                    <label for="modal-prof-pin" class="block text-xs font-bold text-slate-700 uppercase mb-1">PIN Institucional</label>
                    <input type="password" id="modal-prof-pin" required autocomplete="current-password" placeholder="••••••••••••"
                        class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-uniminuto-500 text-slate-800 bg-slate-50 text-sm">
                </div>
                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="closeProfessionalPortalModal()" class="px-5 py-2.5 bg-slate-200 text-slate-700 font-bold rounded-xl text-sm">Cancelar</button>
                    <button type="submit" class="px-6 py-2.5 bg-uniminuto-600 text-white font-bold rounded-xl text-sm shadow">Ingresar al Panel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL DE ELIMINACIÓN SEGURA -->
    <div id="delete-modal" class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-[70] hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-4 border">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="text-base font-extrabold text-rose-700 flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    Eliminar Registro Estudiantil
                </h3>
                <button onclick="closeDeleteModal()" class="text-slate-400 font-bold text-lg">&times;</button>
            </div>
            <p class="text-xs text-slate-600">Esta acción es irreversible y requiere autorización institucional.</p>
            <form onsubmit="confirmDeleteRecord(event)" class="space-y-3">
                <input type="hidden" id="delete-record-index">
                <div>
                    <label class="block text-[10px] font-bold text-slate-700 uppercase mb-1">Nombre del Profesional *</label>
                    <input type="text" id="del-prof-name" required placeholder="Ej. Dr. Andrés Martínez" class="w-full text-xs p-2.5 rounded border bg-slate-50">
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-slate-700 uppercase mb-1">Motivo Fundamentado *</label>
                    <textarea id="del-reason" required rows="2" placeholder="Ej. Duplicidad de registro..." class="w-full text-xs p-2.5 rounded border bg-slate-50"></textarea>
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-slate-700 uppercase mb-1">PIN Institucional *</label>
                    <input type="password" id="del-password" required placeholder="••••••••••••" class="w-full text-xs p-2.5 rounded border bg-slate-50">
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 bg-slate-200 text-slate-700 font-bold rounded text-xs">Cancelar</button>
                    <button type="submit" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded text-xs shadow">Autorizar y Eliminar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL ANALÍTICA DE SEDE -->
    <div id="analytics-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[60] hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-3xl w-full p-6 sm:p-8 space-y-6 max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b pb-4">
                <h3 class="text-xl font-extrabold text-slate-900">📊 Dashboard Institucional de Sede (MEN)</h3>
                <button onclick="document.getElementById('analytics-modal').classList.add('hidden')" class="text-slate-400 font-bold text-xl p-1">&times;</button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-blue-50 p-4 rounded-xl border border-blue-200 text-center">
                    <p class="text-3xl font-black text-blue-900" id="stat-total">0</p>
                    <p class="text-xs font-bold text-blue-700 mt-1 uppercase">Evaluados Totales</p>
                </div>
                <div class="bg-rose-50 p-4 rounded-xl border border-rose-200 text-center">
                    <p class="text-3xl font-black text-rose-900" id="stat-mental">0%</p>
                    <p class="text-xs font-bold text-rose-700 mt-1 uppercase">Sol. Salud Mental</p>
                </div>
                <div class="bg-amber-50 p-4 rounded-xl border border-amber-200 text-center">
                    <p class="text-3xl font-black text-amber-900" id="stat-night">0%</p>
                    <p class="text-xs font-bold text-amber-700 mt-1 uppercase">Nocturna / Laboral</p>
                </div>
            </div>
            <div class="flex justify-end pt-4">
                <button onclick="document.getElementById('analytics-modal').classList.add('hidden')" class="px-5 py-2.5 bg-slate-800 text-white font-bold rounded-xl text-sm">Cerrar</button>
            </div>
        </div>
    </div>

    <!-- MODAL PARA VER EL REPORTE PIAR CON MARCO APA -->
    <div id="modal-student-report" class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-4xl w-full p-6 sm:p-8 space-y-6 my-8 max-h-[90vh] overflow-y-auto relative">
            <div class="flex items-center justify-between border-b pb-4 no-print">
                <div>
                    <span class="bg-uniminuto-50 text-uniminuto-600 font-semibold px-3 py-1 rounded-full text-xs">Vista Profesional • UNIMINUTO</span>
                    <h3 class="text-xl font-extrabold text-slate-900 mt-1">Concepto Guiado de Ajustes Razonables (PIAR) y Marco APA</h3>
                </div>
                <button onclick="closeStudentReportModal()" class="text-slate-400 font-bold text-2xl p-1">&times;</button>
            </div>
            <div id="modal-report-content" class="space-y-6"></div>
            <div class="flex justify-end gap-3 pt-4 border-t no-print">
                <button onclick="printPiarConcept()" class="px-5 py-2.5 bg-uniminuto-600 hover:bg-uniminuto-700 text-white font-bold rounded-xl text-sm flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    <span>Descargar / Imprimir Concepto PIAR (PDF)</span>
                </button>
                <button onclick="closeStudentReportModal()" class="px-5 py-2.5 bg-slate-200 text-slate-700 font-bold rounded-xl text-sm">Cerrar</button>
            </div>
        </div>
    </div>

    <!-- CONTENIDO PRINCIPAL -->
    <main id="main-content" class="flex-grow max-w-5xl w-full mx-auto px-4 py-8" role="main">

        <div id="printable-full-test" class="space-y-6">

            <!-- VISTA 0: INICIO Y CONSENTIMIENTO -->
            <section id="view-start" class="bg-white rounded-3xl shadow-xl p-8 sm:p-12 border border-slate-200 space-y-8">
                <div class="max-w-3xl mx-auto text-center space-y-4">
                    <div class="inline-flex items-center gap-2 bg-uniminuto-50 text-uniminuto-600 font-bold px-4 py-1.5 rounded-full text-xs uppercase border">
                        Corporación Universitaria Minuto de Dios • UNIMINUTO
                    </div>
                    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                        Screening Diagnóstico y Orientación Inclusiva (PSDOI)
                    </h2>
                    <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
                        Área Accesible e Incluyente • Plataforma Oficial de Tamizaje y Ajustes Razonables (PIAR).
                    </p>
                </div>

                <div class="max-w-3xl mx-auto space-y-3 text-left">
                    <details class="group bg-blue-50 border border-blue-200 rounded-xl overflow-hidden cursor-pointer" open>
                        <summary class="font-bold text-uniminuto-700 p-4 flex justify-between items-center select-none">
                            <span class="flex items-center gap-2">
                                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                📜 Consentimiento Informado y Guía de Uso del Lector de Voz
                            </span>
                            <svg class="w-5 h-5 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </summary>
                        <div class="p-4 pt-0 text-sm text-slate-700 border-t border-blue-100 bg-white space-y-3 mt-2">
                            <p><strong>Propósito Exclusivo:</strong> Identificar tus fortalezas de aprendizaje, patrones de lectura y factores de bienestar socioemocional.</p>
                            <p class="text-red-700 font-bold">Aviso de No Evaluabilidad Académica: Este instrumento NO tiene ningún valor cuantitativo, NO representa un examen de admisión, NO otorga notas ni constituye una prueba aprobatoria o reprobatoria.</p>
                            
                            <div class="bg-purple-50 p-3 rounded-lg border border-purple-200 text-xs text-purple-950 space-y-1">
                                <p class="font-bold uppercase tracking-wider">🎧 Guía del Lector de Voz (TTS) y Controles Interactivos:</p>
                                <p>• <strong>1 Toque en "🔊 Escuchar Módulo":</strong> Inicia la lectura completa de las preguntas y opciones del módulo.</p>
                                <p>• <strong>Botón Pausa / Reanudar:</strong> Detiene o continúa la locución en el momento exacto.</p>
                                <p>• <strong>Comando con Tecla M:</strong> 1 pulsación lee el módulo, 2 pulsaciones repiten y 3 pulsaciones avanzan al siguiente apartado automáticamente.</p>
                            </div>
                        </div>
                    </details>
                </div>

                <div class="max-w-md mx-auto pt-4 text-center space-y-4">
                    <label class="flex items-start gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition text-left">
                        <input type="checkbox" id="consent-check" class="mt-1 w-5 h-5 text-uniminuto-600 rounded focus:ring-uniminuto-500">
                        <span class="text-sm font-medium text-slate-700 select-none">
                            He leído y acepto el consentimiento informado y las instrucciones del lector de voz.
                        </span>
                    </label>
                    <p id="consent-error" class="hidden text-xs font-bold text-red-600">⚠️ Debes marcar la casilla para aceptar el consentimiento e iniciar la prueba.</p>
                    
                    <div class="flex flex-col sm:flex-row gap-3">
                        <button onclick="handleStartWithConsent()" 
                            class="flex-1 py-4 px-6 bg-uniminuto-600 hover:bg-uniminuto-700 text-white font-extrabold rounded-xl shadow-lg transition flex items-center justify-center gap-2">
                            <span>Iniciar Prueba</span>
                        </button>
                        <button id="btn-resume-quiz" onclick="resumeAssessment()" 
                            class="hidden flex-1 py-4 px-6 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold rounded-xl shadow-lg transition flex items-center justify-center gap-2">
                            <span>Reanudar Prueba</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- VISTA 1: CUESTIONARIO -->
            <section id="view-quiz" class="hidden space-y-6">
                <div class="bg-blue-50 border-l-4 border-uniminuto-500 p-4 rounded-r-xl shadow-sm text-sm text-slate-700 flex flex-col sm:flex-row gap-3 sm:items-center justify-between">
                    <div>
                        <span class="font-bold text-uniminuto-700">Lector de Voz Accesible (Teclado):</span>
                        <span>Presiona la tecla <strong>M</strong> (1 vez lee, 2 repite, 3 avanza). Usa el botón de abajo para pausar con 1 solo toque.</span>
                    </div>
