        function submitAssessment(event) {
            event.preventDefault();
            const name = document.getElementById('student-name').value.trim();
            const age = document.getElementById('student-age').value.trim();
            const id = document.getElementById('student-id').value.trim();
            const program = document.getElementById('student-program').value;
            const center = document.getElementById('acad-center').value;
            const modality = document.getElementById('acad-modality').value;
            const shift = document.getElementById('acad-shift').value;
            const zone = document.getElementById('socio-zone').value;
            const stratum = document.getElementById('socio-stratum').value;
            const work = document.getElementById('socio-work').value;
            const device = document.getElementById('socio-device').value;
            const wbMental = document.getElementById('wb-mental').checked;
            const wbPhysical = document.getElementById('wb-physical').checked;

            let totalScore = 0;
            let moduleScores = [0, 0, 0, 0];
            modulesData.forEach((mod, modIdx) => {
                if (mod.isScored) {
                    let modCorrect = 0;
                    mod.questions.forEach(q => {
                        const sel = userAnswers[q.id];
                        const corr = q.options.find(o => o.correct);
                        if (sel && corr && sel === corr.id) {
                            modCorrect++;
                        }
                    });
                    const scoreForMod = modCorrect * 2;
                    totalScore += scoreForMod;
                    moduleScores[modIdx] = scoreForMod;
                }
            });

            let risk = "🟢 Estándar";
            if (totalScore < 12 || wbMental || (shift === 'Nocturna' && work.includes('completo'))) {
                risk = "🔴 Prioritario";
            } else if (totalScore < 18 || stratum.includes('1')) {
                risk = "🟡 Moderado";
            }

            const newRec = {
                id, name, age, program, center, modality, shift, zone, stratum, work, device, wbMental, wbPhysical,
                score: totalScore, moduleScores, risk, date: new Date().toLocaleString('es-CO')
            };

            localRecords.unshift(newRec);
            localStorage.setItem('psdoi_prof_records', JSON.stringify(localRecords));
            localStorage.removeItem('psdoi_in_progress');
            saveRecordToGoogleSheets(newRec);

            switchView('results');
            document.getElementById('res-name').textContent = name;
            document.getElementById('res-age-id').textContent = `${age} años / ID: ${id}`;
            document.getElementById('res-program').textContent = `${program} • ${modality} (${shift}) • Sede: ${center}`;

            let recHtml = `<p>¡Hola, <strong>${name}</strong>! Has completado el screening DUA en la sede ${center} para el programa de <strong>${program}</strong>.</p>`;
            if (totalScore >= 18) {
                recHtml += `<p><strong>Destreza Destacada:</strong> Excelente dominio del razonamiento analítico. Te sugerimos participar en semilleros de investigación.</p>`;
            } else if (totalScore >= 10) {
                recHtml += `<p><strong>Competencia Consolidada:</strong> Buen desempeño general con áreas específicas de mejora. Te recomendamos usar organizadores gráficos y visitar el Centro de Escritura UNIMINUTO.</p>`;
            } else {
                recHtml += `<p><strong>Área de Oportunidad y Andamiaje:</strong> Se han detectado oportunidades de apoyo metodológico y adaptativo. Te invitamos a contactar el Área Accesible e Incluyente y aprovechar los cursos nivelatorios.</p>`;
            }
            document.getElementById('student-recommendations-text').innerHTML = recHtml;
        }

