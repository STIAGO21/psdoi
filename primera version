                        <p class="font-bold uppercase tracking-wider">⚠️ Alerta Vocacional y de Saberes Previos:</p>
                        <p>El estudiante aspira al programa de <strong>${rec.program}</strong> pero registra un puntaje crítico en razonamiento cuantitativo (${mathScore}/6). Se sugiere fuertemente activar un <strong>curso nivelatorio de saberes previos en matemáticas</strong> e iniciar tutorías de refuerzo metodológico antes de cursar materias de ciencias básicas.</p>
                    </div>
                `;
            }

            if (rec.score >= 18) {
                theoText = "Procesamiento eficiente y autonomía analítica consolidada (Piaget; CAST, 2018 - DUA; ONU, 2006). Sin requerimiento de refuerzo base (Decreto 1421 de 2017).";
                adjustList = "<li><strong>General:</strong> Sin requerimiento de refuerzo cognitivo base. Ajustes limitados exclusivamente a accesibilidad de formatos.</li>";
            } else if (rec.score >= 10) {
                theoText = "Conflicto cognitivo y BAP metodológicas (Echeita & Ainscow, 2011; Piaget, 1970). Andamiaje parcial y PIAR (Decreto 1421 de 2017; MEN, 2017).";
                adjustList = "<li><strong>Estructura Escrita:</strong> Flexibilización parcial y mapas conceptuales de apoyo.</li><li><strong>Andamiaje:</strong> Guías complementarias en módulos con menor puntaje.</li>";
            } else {
                theoText = "Modelo Social y Sobrecarga Cognitiva (Palacios, 2008; ONU Obs. 4). Obligatoriedad de PIAR y derivación a Bienestar.";
                adjustList = "<li><strong>Fragmentación:</strong> Consignas evaluativas divididas en partes secuenciales.</li><li><strong>Alternativas:</strong> Sustentaciones orales o mapas conceptuales.</li>";
            }

            document.getElementById('modal-report-content').innerHTML = `
                <div class="bg-slate-50 p-4 rounded-xl border grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
                    <div><b>Estudiante:</b> ${rec.name}</div>
                    <div><b>Edad / ID:</b> ${rec.age} / ${rec.id}</div>
                    <div><b>Programa:</b> ${rec.program}</div>
                    <div><b>Sede:</b> ${rec.center} (${rec.modality})</div>
                </div>
                ${vocationalAlert}
                <div class="p-6 rounded-2xl border-2 border-uniminuto-500 bg-white space-y-4 shadow-sm">
                    <h3 class="font-extrabold text-slate-900 text-lg">Concepto Técnico PIAR - Puntaje: ${rec.score}/24</h3>
                    <div class="p-4 bg-slate-50 rounded-xl border text-xs space-y-1">
                        <p class="font-bold uppercase tracking-wider text-uniminuto-700">Fundamentación Teórica APA y Normativa:</p>
                        <p>${theoText}</p>
                    </div>
                    <div>
                        <p class="font-bold text-slate-900 mb-1">Recomendaciones Específicas para el Ajuste Razonable:</p>
                        <ul class="list-disc pl-5 space-y-1 text-sm text-slate-700">${adjustList}</ul>
                    </div>
                </div>
            `;
            document.getElementById('modal-student-report').classList.remove('hidden');
        }

        function closeStudentReportModal() {
            document.getElementById('modal-student-report').classList.add('hidden');
        }

        function printPiarConcept() {
            document.body.classList.add('printing-piar');
            window.print();
            setTimeout(() => { document.body.classList.remove('printing-piar'); }, 500);
        }

        function printCleanTestPDF() {
            document.body.classList.add('printing-clean-test');
            window.print();
            setTimeout(() => { document.body.classList.remove('printing-clean-test'); }, 500);
        }

        function openDeleteModal(index) {
            document.getElementById('delete-record-index').value = index;
            document.getElementById('del-prof-name').value = '';
            document.getElementById('del-reason').value = '';
            document.getElementById('del-password').value = '';
            document.getElementById('delete-modal').classList.remove('hidden');
        }

        function closeDeleteModal() {
            document.getElementById('delete-modal').classList.add('hidden');
        }

        function confirmDeleteRecord(event) {
            event.preventDefault();
            const index = parseInt(document.getElementById('delete-record-index').value);
            const profName = document.getElementById('del-prof-name').value.trim();
            const reason = document.getElementById('del-reason').value.trim();
            const password = document.getElementById('del-password').value.trim();

            if (password !== 'Bienestar2026+') {
                alert('Contraseña institucional incorrecta.');
                return;
            }

            if (isNaN(index) || !localRecords[index]) return;

            const deleted = localRecords.splice(index, 1)[0];
            localStorage.setItem('psdoi_prof_records', JSON.stringify(localRecords));
            closeDeleteModal();
            renderProfessionalDashboardTable();
            alert(`Registro de ${deleted.name} eliminado exitosamente por ${profName}.\nMotivo: "${reason}"`);
        }

        function openAnalyticsModal() {
            const total = localRecords.length;
            const mental = localRecords.filter(r => r.wbMental).length;
            const night = localRecords.filter(r => r.shift === 'Nocturna' || r.work?.includes('completo')).length;

            document.getElementById('stat-total').textContent = total;
            document.getElementById('stat-mental').textContent = total > 0 ? `${Math.round((mental / total) * 100)}%` : '0%';
            document.getElementById('stat-night').textContent = total > 0 ? `${Math.round((night / total) * 100)}%` : '0%';
            document.getElementById('analytics-modal').classList.remove('hidden');
        }

        function exportAllToExcel() {
            const csvRows = [
                ['"CONSOLIDADO INSTITUCIONAL PIAR - PSDOI UNIMINUTO"'],
                ['"Fecha","Estudiante","ID","Programa","Sede","Modalidad","Jornada","Estrato","Puntaje","Semáforo","Salud Mental","Deporte/Cultura"']
            ];
            localRecords.forEach(r => {
                csvRows.push([
                    `"${r.date || ''}"`,
                    `"${r.name || ''}"`,
                    `"${r.id || ''}"`,
                    `"${r.program || ''}"`,
                    `"${r.center || ''}"`,
                    `"${r.modality || ''}"`,
                    `"${r.shift || ''}"`,
                    `"${r.stratum || ''}"`,
                    `"${r.score || 0}/24"`,
                    `"${r.risk || ''}"`,
                    `"${r.wbMental ? 'Sí' : 'No'}"`,
                    `"${r.wbPhysical ? 'Sí' : 'No'}"`
                ]);
            });
            let csvContent = "data:text/csv;charset=utf-8,\uFEFF" + csvRows.map(e => e.join(",")).join("\n");
            let encodedUri = encodeURI(csvContent);
            let link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Consolidado_PIAR_UNIMINUTO.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function restartAssessment() {
            userAnswers = {};
            currentModuleIndex = 0;
            localStorage.removeItem('psdoi_in_progress');
            switchView('start');
        }
    </script>
</body>
</html>
